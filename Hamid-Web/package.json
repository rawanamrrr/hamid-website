{
  "name": "hamid-afandi",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Digitiva",
    "url": "https://www.digitivaa.com/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @hamid/web dev",
    "build": "pnpm --filter @hamid/web build",
    "start": "pnpm --filter @hamid/web start",
    "lint": "pnpm --filter @hamid/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @hamid/db generate",
    "db:migrate": "pnpm --filter @hamid/db migrate",
    "db:seed": "pnpm --filter @hamid/db seed",
    "db:studio": "pnpm --filter @hamid/db studio",
    "db:dump": "pnpm --filter @hamid/db dump"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
